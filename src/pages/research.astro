---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";

// Edit individual research directions in `src/content/research/`.
const rawDirections = (await getCollection("research")).sort(
  (a, b) => a.data.order - b.data.order,
);

const directions = await Promise.all(
  rawDirections.map(async (entry) => {
    const { Content } = await entry.render();
    return { ...entry, Content };
  }),
);
---

<BaseLayout
  title="Research"
  description="Research on fixed-measurement quantum realizability, genuine multipartite-entanglement certification, tripartite correlation-tensor structure, and mixed-state Bell-violation boundaries."
>
  <section class="page-intro">
    <p class="eyebrow">Research</p>
    <h1>Current Directions</h1>
    <p class="lead">
      My research lies at the interface of quantum information theory and
      quantum foundations, and centers on quantum nonlocality and multipartite
      entanglement. Working in the tripartite Bell scenario with the local
      measurements held fixed, I study the exact quantum realizability of
      correlation data, the certification of genuine multipartite entanglement,
      the correlation-tensor structure of tripartite states, and the boundaries
      of Bell-inequality violation for mixed states. The first two sections
      below report results I have obtained; the last is a direction I hope to
      pursue.
    </p>
  </section>

  <section class="stack">
    {
      directions.map((direction) => (
        <article class="card">
          <h2>{direction.data.title}</h2>
          <p class="meta">{direction.data.summary}</p>
          <ul class="tag-list">
            {direction.data.keywords.map((keyword) => (
              <li>{keyword}</li>
            ))}
          </ul>
          <div class="prose">
            <direction.Content />
          </div>
        </article>
      ))
    }
  </section>
</BaseLayout>
