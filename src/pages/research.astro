---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";

// Edit individual research directions in `src/content/research/`.
const rawDirections = (await getCollection("research")).sort(
  (a, b) => a.data.order - b.data.order,
);

const directions = await Promise.all(
  rawDirections.map(async (entry) => {
    const { Content } = await entry.render();
    return { ...entry, Content };
  }),
);
---

<BaseLayout
  title="Research"
  description="Research projects in tripartite quantum realizability, Bell nonlocality, and multipartite quantum correlations."
>
  <section class="page-intro">
    <p class="eyebrow">Research</p>
    <h1>Current Directions</h1>
    <p class="lead">
      My current research lies at the interface of quantum information theory
      and quantum foundations. I study the quantum realizability of multipartite
      correlation data, with particular emphasis on the joint roles of quantum
      states and local measurement settings. My work also investigates the
      correlation-tensor structures of tripartite entangled states and their
      relationship with Bell nonlocality. In the longer term, I aim to extend
      these questions from tripartite scenarios to general multipartite systems.
      I also have a developing interest in tensor-network methods, although this
      is not yet part of my current research projects.
    </p>
  </section>

  <section class="stack">
    {
      directions.map((direction) => (
        <article class="card">
          <h2>{direction.data.title}</h2>
          <p class="meta">{direction.data.summary}</p>
          <ul class="tag-list">
            {direction.data.keywords.map((keyword) => (
              <li>{keyword}</li>
            ))}
          </ul>
          <div class="prose">
            <direction.Content />
          </div>
        </article>
      ))
    }
  </section>
</BaseLayout>
