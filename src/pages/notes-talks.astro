---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import { profile } from "../data/profile";

const withBase = (path: string) =>
  path.startsWith("/") ? `${import.meta.env.BASE_URL}${path.slice(1)}` : path;

// A note becomes public only once it has a real PDF. Entries without one stay
// in the repository but are not rendered; adding a valid `pdf` publishes them.
const hasPdf = (pdf: string | undefined): pdf is string =>
  typeof pdf === "string" && pdf.trim().length > 0;

const rawNotes = (await getCollection("notes"))
  .filter((note) => hasPdf(note.data.pdf))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

// `pdf` is optional in the schema, so resolve the href through an explicit
// guard rather than relying on the filter above to narrow the type.
const notes = await Promise.all(
  rawNotes.map(async (entry) => {
    const { Content } = await entry.render();
    const pdf = entry.data.pdf;
    return { ...entry, Content, pdfHref: hasPdf(pdf) ? withBase(pdf) : null };
  }),
);
---

<BaseLayout title="Notes">
  <section class="page-intro">
    <p class="eyebrow">Notes</p>
    <h1>Notes</h1>
    <p class="lead">
      Selected notes from my coursework and research. Public files are linked
      when available.
    </p>
    <p>
      Many of these notes are works in progress and may contain mistakes or
      omissions. I welcome corrections, suggestions, and discussions from
      interested readers. Please feel free to contact me at {
        profile.contact.email
      }.
    </p>
  </section>

  {
    notes.length > 0 && (
      <section class="section">
        <div class="stack">
          {notes.map((entry) => (
            <article class="card">
              <h2>{entry.data.title}</h2>
              <p class="meta">
                {entry.data.year ?? entry.data.date.getUTCFullYear()}
                {entry.data.status ? ` - ${entry.data.status}` : ""}
              </p>
              {entry.pdfHref && (
                <p>
                  <a
                    class="button-link"
                    href={entry.pdfHref}
                    target="_blank"
                    rel="noopener noreferrer"
                  >
                    View PDF
                  </a>
                </p>
              )}
              <div class="prose">
                <entry.Content />
              </div>
            </article>
          ))}
        </div>
      </section>
    )
  }
</BaseLayout>
