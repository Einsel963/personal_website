---
import BaseLayout from "../layouts/BaseLayout.astro";
import { profile } from "../data/profile";

const withBase = (path: string) =>
  path.startsWith("/") ? `${import.meta.env.BASE_URL}${path.slice(1)}` : path;
---

<BaseLayout title="CV">
  <section class="page-intro">
    <p class="eyebrow">Curriculum Vitae</p>
    <h1>{profile.name}</h1>
    <p class="lead">
      {profile.contact.location} &middot; {profile.contact.email} &middot;{" "}
      <a href={profile.contact.github}>GitHub</a>
    </p>
    <p>
      <a class="button-link" href={withBase(profile.cv.pdfPath)} download>
        Download PDF CV
      </a>
    </p>
  </section>

  <section class="stack">
    <article class="card">
      <h2>Education</h2>
      <div class="stack">
        <div>
          <h3>Jilin University</h3>
          <p class="meta">
            B.Eng. in Traffic and Transportation<br />
            Sept. 2021 &ndash; Jun. 2026<br />
            Changchun, China
          </p>
          <p>GPA: 3.16/4.0; Overall average: 84.39/100</p>
          <p class="meta">Physics and Mathematics</p>
          <ul>
            <li>Quantum Mechanics (95.1)</li>
            <li>Thermodynamics and Statistical Physics (80.2)</li>
            <li>Calculus (93)</li>
            <li>Mathematical Modeling (95)</li>
            <li>University Physics (85.6)</li>
            <li>Electrodynamics (82.6)</li>
            <li>Lie Groups and Lie Algebras (95)</li>
            <li>Methods of Mathematical Physics II (86.2)</li>
          </ul>
        </div>
        <div>
          <h3>Jilin University</h3>
          <p class="meta">
            Minor in Quantum Information Science<br />
            Sept. 2025 &ndash; Jun. 2026<br />
            Changchun, China
          </p>
          <p class="meta">Selected Coursework</p>
          <ul>
            <li>Introduction to Quantum Information</li>
            <li>Quantum Optics</li>
            <li>Quantum Computing</li>
            <li>Quantum Precision Measurement</li>
          </ul>
        </div>
      </div>
    </article>

    <article class="card">
      <h2>Research Experience</h2>
      <div class="stack">
        <div>
          <h3>
            Fixed-Measurement Quantum Correlations and Tripartite Entanglement
          </h3>
          <p class="meta">
            University of Tokyo<br />
            July 2025 &ndash; Present<br />
            Supervisor: Prof. Naomichi Hatano<br />
            Research Mentor: Asst. Prof. Jaeha Lee
          </p>
        </div>

        <div>
          <h3>Nuclear Matter Phase Structure Study</h3>
          <p class="meta">
            Institute of Modern Physics, Chinese Academy of Sciences<br />
            June 2023 &ndash; Aug. 2023<br />
            Supervisor: Hao Qiu
          </p>
        </div>
      </div>
    </article>

    <article class="card">
      <h2>Skills</h2>
      <div class="card-grid two-column">
        <div>
          <h3>Programming and Scientific Computing</h3>
          <ul>
            <li>Python: NumPy, SciPy, CVXPY, Matplotlib</li>
            <li>C/C++</li>
            <li>MATLAB</li>
            <li>CERN ROOT</li>
          </ul>
        </div>
        <div>
          <h3>Numerical Methods</h3>
          <ul>
            <li>Monte Carlo sampling</li>
            <li>Analytical and numerical parameter optimization</li>
            <li>Semidefinite programming</li>
            <li>NPA hierarchy</li>
          </ul>
        </div>
        <div>
          <h3>Machine Learning and Data Analysis</h3>
          <ul>
            <li>Feedforward neural networks</li>
            <li>GRU and LSTM models</li>
            <li>Clustering</li>
            <li>Time-series forecasting</li>
            <li>Model evaluation</li>
          </ul>
        </div>
        <div>
          <h3>Research Tools</h3>
          <ul>
            <li>LaTeX</li>
            <li>Git</li>
            <li>COMSOL</li>
          </ul>
        </div>
      </div>
    </article>

    <article class="card">
      <h2>Honors and Awards</h2>
      <ul>
        <li>
          Second-Class Scholarship (Rank 7/74), Jilin University, Apr. 2026
        </li>
        <li>
          College Excellent Student (Rank 7/74), Jilin University, Apr. 2026
        </li>
        <li>
          Provincial Second Prize, National College Students Mathematical
          Contest in Modeling, Chinese Society of Industrial and Applied
          Mathematics, Dec. 2023
        </li>
        <li>
          Second Prize, China Undergraduate Physics Tournament (CUPT), College
          of Physics, Jilin University, Dec. 2022
        </li>
      </ul>
    </article>

    <article class="card">
      <h2>Selected Academic Programs</h2>
      <div class="stack">
        <div>
          <h3>Physics of Open Systems: Resonance, Symmetry and Topology</h3>
          <p class="meta">University of Tokyo, Aug. 2025</p>
          <p>
            Topics: Open quantum systems, non-Hermitian physics, and Floquet
            topology.
          </p>
        </div>
        <div>
          <h3>International Summer School for Graduate Students on Optics</h3>
          <p class="meta">Fudan University, Aug. 2024</p>
          <p>
            Topics: Quantum optics, nanophotonics, and nonlinear and ultrafast
            optics.
          </p>
        </div>
      </div>
    </article>
  </section>
</BaseLayout>
