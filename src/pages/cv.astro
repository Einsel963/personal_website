---
import BaseLayout from "../layouts/BaseLayout.astro";
import { profile } from "../data/profile";

const withBase = (path: string) =>
  path.startsWith("/") ? `${import.meta.env.BASE_URL}${path.slice(1)}` : path;
---

<BaseLayout title="CV">
  <section class="page-intro">
    <p class="eyebrow">Curriculum Vitae</p>
    <h1>Short Web CV</h1>
    <p class="lead">
      This page provides a brief academic self-introduction, including my
      education, research experience, academic activities, honors, and technical
      background. A PDF version of my CV is also available for reference.
    </p>
  </section>

  <section class="stack">
    <article class="card">
      <h2>Profile</h2>
      <p>
        I recently graduated from Jilin University and am preparing for graduate
        study in physics. My current research focuses on multipartite Bell
        nonlocality, quantum realizability, entanglement structures, and
        numerical methods for quantum correlations.
      </p>
      <p>
        My broader interests include quantum many-body systems and open and
        nonequilibrium quantum systems. I also have an emerging interest in
        tensor-network methods and their applications to quantum many-body
        systems and quantum computation.
      </p>
      <p>
        <a class="button-link" href={withBase(profile.cv.pdfPath)} download>
          Download PDF CV
        </a>
      </p>
    </article>

    <article class="card">
      <h2>Education</h2>
      <div class="stack">
        <div>
          <h3>Jilin University</h3>
          <p>
            B.Eng. in Transportation Engineering<br />
            Sept. 2021 – Jun. 2026<br />
            Overall average: 84.16/100
          </p>
        </div>
        <div>
          <h3>Jilin University</h3>
          <p>
            Minor in Quantum Information Science<br />
            Sept. 2025 – Jun. 2026
          </p>
        </div>
      </div>
    </article>

    <article class="card">
      <h2>Selected Coursework</h2>
      <div class="card-grid two-column">
        <div>
          <h3>Physics and Mathematics</h3>
          <ul>
            <li>Quantum Mechanics</li>
            <li>Thermodynamics and Statistical Physics</li>
            <li>Electrodynamics</li>
            <li>Lie Groups and Lie Algebras</li>
            <li>Methods of Mathematical Physics II</li>
            <li>Calculus</li>
            <li>Linear Algebra</li>
            <li>Mathematical Modeling</li>
          </ul>
        </div>
        <div>
          <h3>Quantum Information</h3>
          <ul>
            <li>Introduction to Quantum Information</li>
            <li>Laser Spectroscopy</li>
            <li>Quantum Optics</li>
            <li>Quantum Computing</li>
            <li>Quantum Precision Measurement</li>
          </ul>
        </div>
        <div>
          <h3>Computing and Data Science</h3>
          <ul>
            <li>University Computer</li>
            <li>Artificial Intelligence</li>
            <li>Theory and Practice of Artificial Intelligence</li>
            <li>Theory and Method of Transportation Big Data</li>
            <li>Course Experiment of Transport Big Data Theory and Method</li>
            <li>Simulation Experiment of Transportation Planning</li>
          </ul>
        </div>
      </div>
    </article>

    <article class="card">
      <h2>Research Experience</h2>
      <div class="stack">
        <div>
          <h3>
            Quantum Nonlocality and Multipartite Entanglement in the (3,2,2)
            Scenario
          </h3>
          <p class="meta">
            University of Tokyo<br />
            July 2025 – Present<br />
            Supervisor: Prof. Naomichi Hatano<br />
            Research Mentor: Asst. Prof. Jaeha Lee
          </p>
          <ul>
            <li>
              Developed a systematic framework for tripartite Bell-violation
              mechanisms in the (3,2,2) scenario, showing how entanglement
              structure and local measurement geometry jointly determine Mermin
              and Svetlichny violations.
            </li>
            <li>
              Classified correlations across fully separable, biseparable, and
              genuinely multipartite-entangled sectors; derived a CHSH-type
              factorization for biseparable states, proved the Svetlichny bound
              |S| ≤ 4, and characterized generalized GHZ, W, and representative
              mixed-state families.
            </li>
            <li>
              Analyzed the block structure and singular-value spectra of
              multipartite correlation tensors to identify measurement-sensitive
              sectors and explain violation enhancement and branch switching in
              GHZ–W mixtures.
            </li>
            <li>
              Developed reproducible Python workflows combining Monte Carlo
              sampling, analytical and numerical parameter optimization, and
              semidefinite programming based on the NPA hierarchy to map
              violation regions and verify analytical boundaries.
            </li>
          </ul>
        </div>

        <div>
          <h3>Nuclear Matter Phase Structure Study</h3>
          <p class="meta">
            Institute of Modern Physics, Chinese Academy of Sciences<br />
            June 2023 – Aug. 2023<br />
            Supervisor: Hao Qiu
          </p>
          <ul>
            <li>
              Studied the phase structure of nuclear matter, with emphasis on
              quark confinement, quark–gluon plasma, and critical behavior.
            </li>
            <li>
              Conducted data analysis and numerical model implementation using
              CERN ROOT, including exploratory work on hypernucleus
              reconstruction.
            </li>
          </ul>
        </div>
      </div>
    </article>

    <article class="card">
      <h2>Skills</h2>
      <div class="card-grid two-column">
        <div>
          <h3>Programming and Scientific Computing</h3>
          <ul>
            <li>Python: NumPy, SciPy, CVXPY, Matplotlib</li>
            <li>C/C++</li>
            <li>MATLAB</li>
            <li>CERN ROOT</li>
          </ul>
        </div>
        <div>
          <h3>Numerical Methods</h3>
          <ul>
            <li>Monte Carlo sampling</li>
            <li>Analytical and numerical parameter optimization</li>
            <li>Semidefinite programming</li>
            <li>NPA hierarchy</li>
          </ul>
        </div>
        <div>
          <h3>Machine Learning and Data Analysis</h3>
          <ul>
            <li>Feedforward neural networks</li>
            <li>GRU and LSTM models</li>
            <li>Clustering</li>
            <li>Time-series forecasting</li>
            <li>Feature preprocessing</li>
            <li>Model evaluation</li>
          </ul>
        </div>
        <div>
          <h3>Research Tools and Languages</h3>
          <ul>
            <li>LaTeX</li>
            <li>Git</li>
            <li>COMSOL</li>
            <li>Chinese: native</li>
            <li>English: TOEFL 89</li>
          </ul>
        </div>
      </div>
    </article>

    <article class="card">
      <h2>Honors and Awards</h2>
      <ul>
        <li>
          Second-Class Scholarship, Jilin University, Rank 7/74, Apr. 2026
        </li>
        <li>
          College Excellent Student, Jilin University, Rank 7/74, Apr. 2026
        </li>
        <li>
          Provincial Second Prize, National College Students Mathematical
          Contest in Modeling, Dec. 2023
        </li>
        <li>Second Prize, China Undergraduate Physics Tournament, Dec. 2022</li>
      </ul>
    </article>

    <article class="card">
      <h2>Selected Academic Programs</h2>
      <div class="stack">
        <div>
          <h3>Physics of Open Systems: Resonance, Symmetry and Topology</h3>
          <p class="meta">University of Tokyo, Aug. 2025</p>
          <p>
            Topics: Open quantum systems, non-Hermitian physics, and Floquet
            topology.
          </p>
        </div>
        <div>
          <h3>International Summer School for Graduate Students on Optics</h3>
          <p class="meta">Fudan University, Aug. 2024</p>
          <p>
            Topics: Quantum optics, nanophotonics, and nonlinear and ultrafast
            optics.
          </p>
        </div>
      </div>
    </article>
  </section>
</BaseLayout>
